MONGODB_URI=mongodb://127.0.0.1:27017/gofitnow

# SMTP — with SMTP_HOST empty the app falls back to Ethereal: a throwaway test
# inbox is created on the fly and a preview URL is logged, so the e-mail flow
# can be developed without any credential.
#
# Gmail needs an App Password (Google account with 2FA on), not the account
# password. Any other provider works the same way — Resend uses
# smtp.resend.com with user "resend" and the API key as the password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GoFitNow <contato@gofitnow.fit>

# Base URL used to build the links inside the e-mails.
APP_URL=http://localhost:5180

# ── OS ARQUIVOS, NO CLOUDFLARE R2 ─────────────────────────────────────────
#
# Fotos, clipes e documentos moravam DENTRO do Mongo: 151 MB de binário contra
# 6 MB de dados de verdade. Ver lib/arquivos.js.
#
# R2 e não S3 por causa do egress: trazer um arquivo do R2 para este servidor não
# custa banda. Foi o motivo de a escolha não ser a Amazon.
#
# SEM ESTAS VARIÁVEIS o sistema funciona igual, guardando no banco como antes —
# é o que permite este código estar em produção antes de o bucket existir.
#
# O bucket é PRIVADO: sem domínio público, sem acesso anônimo, e o código não
# gera URL assinada. Quem serve os bytes são as rotas de sempre, com a permissão
# que elas já aplicam.
#
# O token precisa de "Object Read & Write" NESTE bucket, e de mais nada.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gofitnow-arquivos
# Só se você usar um endpoint diferente do padrão (<conta>.r2.cloudflarestorage.com).
R2_ENDPOINT=
